{
    "rewrites": [
        {
            "source": "/:path*",
            "destination": "/index.html"
        }
    ],
    "trailingSlash": false,
    "headers": [
        {
            "source": "/media/(.*\\.(woff|woff2|ttf|eot|svg))",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "font/woff2"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/media/(.*\\.woff)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "font/woff"
                }
            ]
        },
        {
            "source": "/media/(.*\\.ttf)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "font/ttf"
                }
            ]
        },
        {
            "source": "/media/(.*\\.eot)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/vnd.ms-fontobject"
                }
            ]
        },
        {
            "source": "/media/(.*\\.svg)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "image/svg+xml"
                }
            ]
        }
    ]
}